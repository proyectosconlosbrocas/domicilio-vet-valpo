# Copiar a .env (gitignored) y completar con los valores reales del
# dashboard de Supabase (Project Settings → API / Database).
# Usado solo por scripts de servidor/CLI (ej. npm run db:migrate) — nunca
# por código de apps/web o apps/mobile.

SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Conexión a Postgres para aplicar migraciones. Si la conexión directa
# (db.<ref>.supabase.co) da ENOTFOUND, es porque solo resuelve por IPv6 —
# usar en su lugar el "Connection pooler" (Session mode, puerto 5432) desde
# el dashboard: Project Settings → Database → Connection pooling.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=
